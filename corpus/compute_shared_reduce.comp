#version 450
layout(local_size_x = 32, local_size_y = 1, local_size_z = 1) in;
layout(set = 0, binding = 0, std430) buffer Output { uint values[]; } output_buffer;
shared uint partial[32];
void main() {
    uint lane = gl_LocalInvocationID.x;
    partial[lane] = lane;
    barrier();
    for (uint stride = 16u; stride > 0u; stride >>= 1u) {
        if (lane < stride) partial[lane] += partial[lane + stride];
        barrier();
    }
    if (lane == 0u) output_buffer.values[gl_WorkGroupID.x] = partial[0];
}
